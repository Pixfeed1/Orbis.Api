<?xml version="1.0"?>
<ruleset name="Gestionnaire Colis Pro">
	<description>Coding standards for the Gestionnaire Colis Pro plugin.</description>

	<file>gestionnaire-colis-pro</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress">
		<!-- Filenames follow the class-*.php convention used here. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="gestionnaire-colis-pro"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="pxfwd"/>
				<element value="PXFWD"/>
			</property>
		</properties>
	</rule>

	<!-- WooCommerce e-mail templates must fire WooCommerce's own header/footer
	     hooks to render inside the shop e-mail layout. Those hook names belong
	     to WooCommerce and must not carry this plugin's prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>*/templates/emails/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="pxfwd_manage"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.2"/>
</ruleset>
