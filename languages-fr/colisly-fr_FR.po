msgid "You have no parcel in stock to declare."
msgstr "Vous n’avez aucun colis en stock à déclarer."

msgid "Nothing declared for this parcel."
msgstr "Rien n’est déclaré pour ce colis."

msgid "Detailed description of contents"
msgstr "Désignation détaillée du contenu"

msgid "Net weight (kg)"
msgstr "Poids net (kg)"

