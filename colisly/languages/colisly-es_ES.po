msgid "[%1$s] Your parcel %2$s has been received"
msgstr "[%1$s] Su paquete %2$s ha sido recibido"

msgid "Hello,\n\nWe have received your parcel %1$s (weight: %2$s kg, tracking number: %3$s).\n\nIt is now available in your account, under “My parcels”. You benefit from %4$d days of free storage.\n\nBest regards"
msgstr "Hola,\n\nHemos recibido su paquete %1$s (peso: %2$s kg, número de seguimiento: %3$s).\n\nYa está disponible en su cuenta, en «Mis paquetes». Dispone de %4$d días de almacenamiento gratuito.\n\nUn cordial saludo"

msgid "New shipment request %1$s (client %2$s)"
msgstr "Nueva solicitud de envío %1$s (cliente %2$s)"

msgid "A new shipment request %1$s has just been created by client %2$s.\n\nNumber of parcels: %3$d\nPreferred carrier: %4$s\n\nLog in to the administration to process it."
